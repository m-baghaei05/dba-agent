# Copy this file to .env and fill in the key(s) for the provider(s) you use.
# .env is listed in .gitignore, so your real keys never reach Git.

AVALAI_API_KEY=
GAPGPT_API_KEY=
KILO_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=

# Optional: overrides `active_profile` in config.yaml without editing any file.
# DBA_PROFILE=avalai
